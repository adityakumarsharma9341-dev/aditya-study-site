{
  "rewrites": [
    { "source": "/av-app", "destination": "/api/avproxy?__path=/" },
    { "source": "/av-app/:path*", "destination": "/api/avproxy?__path=/:path*" },
    { "source": "/play.php", "destination": "/api/avproxy?__path=/play.php" },
    { "source": "/download.php", "destination": "/api/avproxy?__path=/download.php" },
    { "source": "/downloader.php", "destination": "/api/avproxy?__path=/downloader.php" },
    { "source": "/:file(.*\\.php)", "destination": "/api/avproxy?__path=/:file" },
    { "source": "/api/avproxy", "destination": "/api/avproxy.js" },
    { "source": "/api/:path*", "destination": "/api/avproxy?__path=/api/:path*" },
    { "source": "/assets/:path*", "destination": "https://stream.aryavidya.cc/assets/:path*" },
    { "source": "/stream/:path*", "destination": "https://stream.aryavidya.cc/stream/:path*" },
    { "source": "/proxy/:path*", "destination": "https://stream.aryavidya.cc/proxy/:path*" }
  ]
}
